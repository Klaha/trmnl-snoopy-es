<!-- Markup for the "Full" layout of the TRMNL private plugin. Paste it into the plugin's Markup Editor. -->
<!-- The strip is already reduced to the OG's 4 grays, so no image-dither class here. -->
<div class="layout layout--col layout--center">
  <img
    src="https://klaha.github.io/trmnl-snoopy-es/strip.png?v={{ date }}"
    alt="Snoopy en Español"
    style="max-width: 100%; max-height: 100%; image-rendering: pixelated;"
  >
</div>

<div class="title_bar">
  <span class="title">Snoopy</span>
  <span class="instance">{{ date_label }}</span>
</div>
