<!-- Markup for the "Full" layout of the TRMNL private plugin. Paste it into the plugin's Markup Editor. -->
<!-- The strips come in colour: go to grayscale and push light pastel backgrounds to white
     (brightness 1.28 sends every gray >= 200 to 255) so they don't turn into gray noise on e-ink. -->
<div class="layout layout--col layout--center">
  <img
    src="{{ image_url }}"
    alt="Snoopy en Español"
    style="max-width: 100%; max-height: 100%; filter: grayscale(1) brightness(1.28);"
  >
</div>

<div class="title_bar">
  <span class="title">Snoopy</span>
  <span class="instance">{{ date_label }}</span>
</div>
